# ====================================================================
# SecuDoc Environment Configuration Example
# ====================================================================
# DO NOT COMMIT SENSITIVE SECRETS TO PUBLIC SOURCE CONTROL

# Operational Mode
# DEMO_MODE=1 enables classroom demo fixtures, Attack Lab simulator, and demo accounts.
# DEMO_MODE=0 enforces production constraints: strict SECRET_KEY requirement, disables Attack Lab mutations.
DEMO_MODE=1

# Flask Application & Security Secrets
# In production (DEMO_MODE=0), SECRET_KEY MUST be a unique, cryptographically random string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1
USE_HTTPS=0

# Security & Cryptography Parameters
RSA_KEY_SIZE=2048
PASSWORD_HASH_ITERATIONS=100000
MAX_CONTENT_LENGTH_BYTES=10485760  # 10 MB upload limit
RATE_LIMIT_PER_MINUTE=60
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Storage Paths
DATABASE_PATH=data/secudoc.db
ATTACK_SANDBOX_DB=data/attack_sandbox.db
UPLOAD_FOLDER=data/uploads
KEY_STORE_FOLDER=data/keys

